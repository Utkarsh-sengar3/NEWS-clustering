# Backend-only secrets. Do not put these in the Next.js frontend.
# Copy this file to .env and fill in values locally. Never commit real keys.

# OpenAI-compatible LLM (orchestrator). Unused for news generation in Phase 1.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional alias recognized by the agent config
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Reserved for a later news API provider. RSS can ship without this.
NEWS_API_KEY=
